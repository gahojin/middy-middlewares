# 全ファイルを無視する
*

!.gitignore
!.gitkeep

!/.github/
!/.github/workflows/
!/.github/workflows/*.yml
!/.github/dependabot.yml
!/.github/zizmor.yml

!*.ts
!*.tsx
!*.md

!/packages/
!/packages/*/
!/packages/*/src/
!/packages/*/src/**/

!package.json
!tsconfig.json

!/.editorconfig
!/.ncurc.cjs
!/.npmrc
!/biome.jsonc
!/bumpver.toml
!/commitlint.config.cjs
!/lefthook.yaml
!/LICENSE
!/mise.toml
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.base.json
!/turbo.json
